{
  "schemaVersion": 1,
  "name": "frame-ship-finance",
  "displayName": "Frame-ship Finance",
  "version": "6.4.2",
  "description": "Core skills library for Muse: FP&A, accounting close, compliance, personal finance, and investment analysis",
  "compat": {
    "source": "native",
    "manifestDir": ".muse-plugin"
  },
  "capabilities": {
    "skills": [
      {
        "id": "using-finance",
        "path": "skills/using-finance/SKILL.md"
      },
      {
        "id": "financial-discovery",
        "path": "skills/financial-discovery/SKILL.md"
      },
      {
        "id": "financial-shaping",
        "path": "skills/financial-shaping/SKILL.md"
      },
      {
        "id": "financial-planning",
        "path": "skills/financial-planning/SKILL.md"
      },
      {
        "id": "financial-delivery",
        "path": "skills/financial-delivery/SKILL.md"
      },
      {
        "id": "financial-verification",
        "path": "skills/financial-verification/SKILL.md"
      },
      {
        "id": "diagnosing-finance",
        "path": "skills/diagnosing-finance/SKILL.md"
      },
      {
        "id": "budgeting-forecasting",
        "path": "skills/budgeting-forecasting/SKILL.md"
      },
      {
        "id": "financial-analysis",
        "path": "skills/financial-analysis/SKILL.md"
      },
      {
        "id": "financial-modeling",
        "path": "skills/financial-modeling/SKILL.md"
      },
      {
        "id": "personal-finance",
        "path": "skills/personal-finance/SKILL.md"
      },
      {
        "id": "accounting-close",
        "path": "skills/accounting-close/SKILL.md"
      },
      {
        "id": "compliance-tax",
        "path": "skills/compliance-tax/SKILL.md"
      },
      {
        "id": "investment-research",
        "path": "skills/investment-research/SKILL.md"
      }
    ],
    "hooks": [
      {
        "event": "SessionStart",
        "command": [
          "sh",
          "hooks/session-start"
        ],
        "timeoutMs": 5000
      }
    ],
    "mcpServers": [],
    "reminders": []
  }
}
