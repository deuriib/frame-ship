{
  "schemaVersion": 1,
  "name": "superpowers-security",
  "displayName": "Security",
  "version": "6.4.2",
  "description": "Security skills library for Muse: threat modeling, secure code, review, incident response",
  "compat": {
    "source": "native",
    "manifestDir": ".muse-plugin"
  },
  "capabilities": {
    "skills": [
      {
        "id": "incident-response",
        "path": "skills/incident-response/SKILL.md"
      },
      {
        "id": "secure-code-review",
        "path": "skills/secure-code-review/SKILL.md"
      },
      {
        "id": "secure-implementation",
        "path": "skills/secure-implementation/SKILL.md"
      },
      {
        "id": "threat-modeling",
        "path": "skills/threat-modeling/SKILL.md"
      },
      {
        "id": "using-security",
        "path": "skills/using-security/SKILL.md"
      },
      {
        "id": "verification-before-release",
        "path": "skills/verification-before-release/SKILL.md"
      },
      {
        "id": "vulnerability-debugging",
        "path": "skills/vulnerability-debugging/SKILL.md"
      },
      {
        "id": "writing-secure-plans",
        "path": "skills/writing-secure-plans/SKILL.md"
      }
    ],
    "commands": [],
    "hooks": [
      {
        "id": "session-start",
        "event": "SessionStart",
        "command": [
          "sh",
          "hooks/session-start"
        ],
        "timeoutMs": 5000
      }
    ],
    "mcpServers": [],
    "reminders": []
  }
}
