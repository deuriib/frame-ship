{
  "schemaVersion": 1,
  "name": "superpowers-revenue",
  "displayName": "Revenue Powers",
  "version": "6.4.2",
  "description": "Revenue skills library for Muse: discover, offer, price, outbound, close, scale",
  "compat": {
    "source": "native",
    "manifestDir": ".muse-plugin"
  },
  "capabilities": {
    "skills": [
      {
        "id": "using-revenue",
        "path": "skills/using-revenue/SKILL.md"
      },
      {
        "id": "discovering-clients",
        "path": "skills/discovering-clients/SKILL.md"
      },
      {
        "id": "designing-offer",
        "path": "skills/designing-offer/SKILL.md"
      },
      {
        "id": "pricing-offers",
        "path": "skills/pricing-offers/SKILL.md"
      },
      {
        "id": "outbound-prospecting",
        "path": "skills/outbound-prospecting/SKILL.md"
      },
      {
        "id": "closing-deals",
        "path": "skills/closing-deals/SKILL.md"
      },
      {
        "id": "scaling-revenue",
        "path": "skills/scaling-revenue/SKILL.md"
      }
    ],
    "commands": [],
    "hooks": [
      {
        "id": "session-start",
        "event": "SessionStart",
        "command": [
          "sh",
          "hooks/session-start"
        ],
        "timeoutMs": 5000
      }
    ],
    "mcpServers": [],
    "reminders": []
  }
}
