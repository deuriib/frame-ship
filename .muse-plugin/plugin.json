{
  "schemaVersion": 1,
  "name": "frame-ship",
  "displayName": "Product",
  "version": "6.4.2",
  "description": "Core skills library for Muse: product discovery, PRDs, validation, launch, and growth workflows",
  "compat": {
    "source": "native",
    "manifestDir": ".muse-plugin"
  },
  "capabilities": {
    "skills": [
      {
        "id": "using-product",
        "path": "skills/using-product/SKILL.md"
      },
      {
        "id": "product-discovery",
        "path": "skills/product-discovery/SKILL.md"
      },
      {
        "id": "writing-prds",
        "path": "skills/writing-prds/SKILL.md"
      },
      {
        "id": "validating-bets",
        "path": "skills/validating-bets/SKILL.md"
      },
      {
        "id": "shipping-product",
        "path": "skills/shipping-product/SKILL.md"
      },
      {
        "id": "diagnosing-funnel",
        "path": "skills/diagnosing-funnel/SKILL.md"
      },
      {
        "id": "diagnosing-product",
        "path": "skills/diagnosing-product/SKILL.md"
      },
      {
        "id": "pricing-packaging",
        "path": "skills/pricing-packaging/SKILL.md"
      },
      {
        "id": "go-to-market",
        "path": "skills/go-to-market/SKILL.md"
      },
      {
        "id": "analytics-growth",
        "path": "skills/analytics-growth/SKILL.md"
      },
      {
        "id": "verification-before-launch",
        "path": "skills/verification-before-launch/SKILL.md"
      },
      {
        "id": "requesting-product-review",
        "path": "skills/requesting-product-review/SKILL.md"
      },
      {
        "id": "writing-skills",
        "path": "skills/writing-skills/SKILL.md"
      }
    ],
    "commands": [],
    "hooks": [
      {
        "id": "session-start",
        "event": "SessionStart",
        "command": [
          "sh",
          "hooks/session-start"
        ],
        "timeoutMs": 5000
      }
    ],
    "mcpServers": [],
    "reminders": []
  }
}
