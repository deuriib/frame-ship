{
  "schemaVersion": 1,
  "name": "superpowers",
  "displayName": "Superpowers",
  "version": "6.4.2",
  "description": "Core skills library for Muse: Excel-first automation, TDD builds, shipping, Micro-SaaS pricing",
  "compat": {
    "source": "native",
    "manifestDir": ".muse-plugin"
  },
  "capabilities": {
    "skills": [
      {
        "id": "building-automation",
        "path": "skills/building-automation/SKILL.md"
      },
      {
        "id": "debugging-automation",
        "path": "skills/debugging-automation/SKILL.md"
      },
      {
        "id": "designing-automation",
        "path": "skills/designing-automation/SKILL.md"
      },
      {
        "id": "discovering-opportunities",
        "path": "skills/discovering-opportunities/SKILL.md"
      },
      {
        "id": "pricing-micro-saas",
        "path": "skills/pricing-micro-saas/SKILL.md"
      },
      {
        "id": "shipping-automation",
        "path": "skills/shipping-automation/SKILL.md"
      },
      {
        "id": "using-automation",
        "path": "skills/using-automation/SKILL.md"
      }
    ],
    "commands": [],
    "hooks": [
      {
        "id": "session-start",
        "event": "SessionStart",
        "command": [
          "sh",
          "hooks/session-start"
        ],
        "timeoutMs": 5000
      }
    ],
    "mcpServers": [],
    "reminders": []
  }
}
